# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage

# Environments
.venv/
venv/
env/
.env

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw and derived data
data/raw/*
data/interim/*
data/processed/*

# Keep directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated outputs
results/figures/*
results/tables/*
results/models/*
results/screening/*
results/logs/*

# Keep result directories
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/models/.gitkeep
!results/screening/.gitkeep
!results/logs/.gitkeep

# Large model/data files
*.pkl
*.joblib
*.pt
*.pth
*.ckpt
*.h5
*.npz

# Temporary
*.tmp
*.temp
*.bak
